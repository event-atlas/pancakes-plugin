{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pancakes": {
      "type": "streamable-http",
      "url": "https://pancakes.design/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": { "mode": "cimd" },
            "baseScopes": ["site:read", "site:edit", "site:schedule"]
          }
        }
      }
    }
  }
}
